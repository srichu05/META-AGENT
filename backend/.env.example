# ==============================================================================
# API KEYS - Meta-Agent Math Debate System
# ==============================================================================

GROQ_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=
HUGGING_FACE_API_KEY=

# ==============================================================================
# FLASK CONFIGURATION
# ==============================================================================

FLASK_ENV=development
DEBUG=True
PORT=5000
SECRET_KEY=
ALLOWED_ORIGINS=*

# ==============================================================================
# SYSTEM SETTINGS (Optional)
# ==============================================================================

VECTOR_DB_PATH=./database/vector_store.db
PROBLEMS_DB_PATH=./data/math_problems.json
SOLUTIONS_DB_PATH=./database/solutions.csv
LOG_FILE_PATH=./logs/app.log

DEBATE_ROUNDS=3
MAX_TOKENS_COMPLETION=2048
TEMPERATURE=0.2

TOP_K_RETRIEVAL=5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.7

LOG_LEVEL=INFO
