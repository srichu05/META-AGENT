# ==============================================================================
# API KEYS - Meta-Agent Math Debate System
# ==============================================================================

# Groq API (Free tier, fast LLM provider)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# Google Gemini API
GEMINI_API_KEY=

# OpenRouter API Key & Configurable Model (Alternative Reasoning Solver)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1-distill-llama-70b

# OpenAI API
OPENAI_API_KEY=

# Cohere API (Retrieval Reranking Only)
COHERE_API_KEY=

# Hugging Face API
HUGGING_FACE_API_KEY=

# ==============================================================================
# FLASK & APP CONFIGURATION
# ==============================================================================

# Flask Environment (development, production, testing)
FLASK_ENV=development

# Debug Mode (True for development, False for production)
DEBUG=True

# Server Port
PORT=5000

# Flask Secret Key
SECRET_KEY=

# CORS Allowed Origins (comma-separated or *)
ALLOWED_ORIGINS=*

# Database URL (SQLite default if unset, or PostgreSQL connection string)
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/meta_agent_math_debate

# File Upload Settings
UPLOAD_FOLDER=./uploads
MAX_UPLOAD_FILE_SIZE_BYTES=26214400

# ==============================================================================
# DATABASE & STORAGE PATHS
# ==============================================================================

VECTOR_DB_PATH=./database/vector_store.db
PROBLEMS_DB_PATH=./data/math_problems.json
SOLUTIONS_DB_PATH=./database/solutions.csv
LOG_FILE_PATH=./logs/app.log
FAISS_INDEX_PATH=./database/document_vectors.faiss
EMBEDDINGS_CACHE=./database/embeddings_cache.pkl

# ==============================================================================
# DEBATE & AGENT SETTINGS
# ==============================================================================

DEBATE_ROUNDS=3
MAX_TOKENS_COMPLETION=2048
TEMPERATURE=0.2
PLANNER_ENABLED=True
REFLECTION_ENABLED=True


# ==============================================================================
# RAG & INGESTION SETTINGS
# ==============================================================================

TOP_K_RETRIEVAL=5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
SIMILARITY_THRESHOLD=0.7
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=32
DOCUMENT_LIST_LIMIT=50
HYBRID_RETRIEVAL_ENABLED=True
BM25_WEIGHT=0.3
FAISS_WEIGHT=0.7
COHERE_RERANK_ENABLED=False
MAX_CONTEXT_LENGTH=4000


# ==============================================================================
# LOCAL MODEL CONFIGURATION (Optional fallback)
# ==============================================================================

LOCAL_MODEL_ENABLED=False
LOCAL_MODEL_NAME=microsoft/Phi-3.5-mini-instruct
LOCAL_MODEL_PATH=./models/phi
LOCAL_MODEL_DEVICE=cpu
LOCAL_MODEL_MAX_TOKENS=4096
LOCAL_MODEL_STYLE=multi_agent

# ==============================================================================
# LOGGING
# ==============================================================================

LOG_LEVEL=INFO
